---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  const tags = [...new Set(notes.flatMap((n) => n.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      notes: notes
        .filter((n) => n.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { notes } = Astro.props;

const dateFR = (d) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base titre={`#${tag}`} description={`Les notes classées dans ${tag}.`}>
  <a class="retour" href="/notes/">← Toutes les notes</a>
  <h1>#{tag}</h1>

  <ul class="notes">
    {notes.map((note) => (
      <li>
        <time datetime={note.data.pubDate.toISOString()}>
          {dateFR(note.data.pubDate)}
        </time>
        <a class="titre" href={`/notes/${note.id}/`}>{note.data.title}</a>
        {note.data.description && <p>{note.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
