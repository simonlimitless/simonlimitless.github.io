---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFR = (d) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base titre="Toutes les notes" description="L'archive complète de mes notes.">
  <h1>Toutes les notes</h1>
  <p class="chapeau">L'archive complète, la plus récente en premier.</p>

  <input
    id="recherche"
    type="search"
    placeholder="Rechercher une note…"
    autocomplete="off"
  />
  <p id="compteur"></p>

  <ul class="notes" id="liste">
    {notes.map((note) => (
      <li data-cherchable={`${note.data.title} ${note.data.description ?? ''} ${note.data.tags.join(' ')}`.toLowerCase()}>
        <time datetime={note.data.pubDate.toISOString()}>
          {dateFR(note.data.pubDate)}
        </time>
        <a class="titre" href={`/notes/${note.id}/`}>{note.data.title}</a>
        {note.data.description && <p>{note.data.description}</p>}
        {note.data.tags.length > 0 && (
          <div class="etiquettes">
            {note.data.tags.map((t) => <a href={`/tags/${t}/`}>#{t}</a>)}
          </div>
        )}
      </li>
    ))}
  </ul>

  <script is:inline>
    const champ = document.getElementById('recherche');
    const lignes = [...document.querySelectorAll('#liste li')];
    const compteur = document.getElementById('compteur');

    champ.addEventListener('input', () => {
      const q = champ.value.trim().toLowerCase();
      let trouvees = 0;
      for (const li of lignes) {
        const ok = !q || li.dataset.cherchable.includes(q);
        li.style.display = ok ? '' : 'none';
        if (ok) trouvees++;
      }
      compteur.textContent = q ? `${trouvees} note(s) trouvée(s)` : '';
    });
  </script>
</Base>
