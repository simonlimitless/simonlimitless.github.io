---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const dateFR = (d) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base titre={undefined} description="Bienvenue sur mes notes.">
  <h1>Le carnet</h1>
  <p class="chapeau">
    Un carnet en ligne : astuces web, dernières astuces sur l'AI, mes recettes, et tout ce que je
    veux garder sous la main.
  </p>

  <ul class="notes">
    {notes.map((note) => (
      <li>
        <time datetime={note.data.pubDate.toISOString()}>
          {dateFR(note.data.pubDate)}
        </time>
        <a class="titre" href={`/notes/${note.id}/`}>{note.data.title}</a>
        {note.data.description && <p>{note.data.description}</p>}
      </li>
    ))}
  </ul>

  <p style="margin-top:34px"><a href="/notes/">Voir toutes les notes →</a></p>
</Base>
